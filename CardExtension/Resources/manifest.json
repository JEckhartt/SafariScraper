{
  "manifest_version": 3,
  "name": "CardScraper",
  "description": "Saves a character page as a Tavern card PNG: the main image with scenario, personality, first message and example dialogs embedded.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png",
      "48": "icon-48.png"
    }
  },
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"]
}
